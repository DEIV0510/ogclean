{
  "redirects": [
    { "source": "/", "destination": "https://ogcleann.com/", "statusCode": 301 },
    { "source": "/index.html", "destination": "https://ogcleann.com/", "statusCode": 301 },
    { "source": "/tienda", "destination": "https://ogcleann.com/tienda/", "statusCode": 301 },
    { "source": "/tienda.html", "destination": "https://ogcleann.com/tienda/", "statusCode": 301 },
    { "source": "/terminos", "destination": "https://ogcleann.com/terminos/", "statusCode": 301 },
    { "source": "/terminos.html", "destination": "https://ogcleann.com/terminos/", "statusCode": 301 },
    { "source": "/(.*)", "destination": "https://ogcleann.com/", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
